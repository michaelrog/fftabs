{
  "manifest_version": 2,
  "name": "fftabs",
  "version": "0.1.0",
  "description": "Grab metadata for all your open tabs as JSON.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["tabs"],
  "browser_action": {
    "default_title": "fftabs",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fftabs@michaelrog.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
